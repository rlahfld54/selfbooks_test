# Backend only. Prefer Supabase Session pooler for a persistent Fastify server.
DIRECT_URL=postgresql://postgres.project-ref:example-password@aws-0-region.pooler.supabase.com:5432/postgres
# Fallback when DIRECT_URL is unset.
# DATABASE_URL=postgresql://postgres.project-ref:example-password@aws-0-region.pooler.supabase.com:6543/postgres
DB_SSL_CA_PATH=backend/.env.supabase-ca.crt
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Only explicitly selected synthetic test records may be served.
DEV_FIXTURE_OFFICE_ID=
DEV_FIXTURE_CLIENT_IDS=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
